@model Projeto1_IF.Models.TbProfissional
@{
    ViewData["Title"] = "Excluir profissional";
    var temPacientes = ViewData["TemPacientes"] is true;
}

<h1>Excluir profissional</h1>
<p>Profissional: <strong>@Model.Nome</strong> — CPF @Model.Cpf</p>
@if (temPacientes)
{
    <div class="alert alert-warning">Este profissional possui pacientes cadastrados e não pode ser excluído.</div>
}
@if (ViewData["ErrorMessage"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Delete" asp-route-id="@Model.IdProfissional" method="post">
    @if (!temPacientes)
    {
        <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
    }
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>

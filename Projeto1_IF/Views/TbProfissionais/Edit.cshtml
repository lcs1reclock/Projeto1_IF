@model Projeto1_IF.Models.TbProfissional
@using Projeto1_IF.Security
@{
    ViewData["Title"] = "Editar profissional";
    var gerente = User.IsInRole(AppRoles.GerenteGeral) || User.IsInRole(AppRoles.GerenteMedico)
        || User.IsInRole(AppRoles.GerenteNutricionista);
}

<h1>Editar profissional</h1>
<form asp-action="Edit" asp-route-id="@Model.IdProfissional" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Cpf" class="form-label">CPF</label>
            @if (gerente)
            {
                <input asp-for="Cpf" class="form-control" />
                <span asp-validation-for="Cpf" class="text-danger"></span>
            }
            else
            {
                <p class="form-control-plaintext">@Model.Cpf</p>
            }
        </div>
        <div class="col-md-3">
            <label asp-for="CrmCrn" class="form-label">CRM/CRN</label>
            <input asp-for="CrmCrn" class="form-control" /><span asp-validation-for="CrmCrn" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Especialidade" class="form-label"></label>
            <input asp-for="Especialidade" class="form-control" /><span asp-validation-for="Especialidade" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="IdCidade" class="form-label">Cidade cadastrada</label>
            <select asp-for="IdCidade" asp-items="@(ViewData["IdCidade"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"></select>
            <span asp-validation-for="IdCidade" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Logradouro" class="form-label"></label>
            <input asp-for="Logradouro" class="form-control" /><span asp-validation-for="Logradouro" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Numero" class="form-label">Número</label>
            <input asp-for="Numero" class="form-control" /><span asp-validation-for="Numero" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Bairro" class="form-label"></label>
            <input asp-for="Bairro" class="form-control" /><span asp-validation-for="Bairro" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Cep" class="form-label">CEP</label>
            <input asp-for="Cep" class="form-control" /><span asp-validation-for="Cep" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Cidade" class="form-label"></label>
            <input asp-for="Cidade" class="form-control" /><span asp-validation-for="Cidade" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Estado" class="form-label"></label>
            <input asp-for="Estado" class="form-control" /><span asp-validation-for="Estado" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Ddd1" class="form-label">DDD 1</label>
            <input asp-for="Ddd1" class="form-control" /><span asp-validation-for="Ddd1" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Telefone1" class="form-label">Telefone 1</label>
            <input asp-for="Telefone1" class="form-control" /><span asp-validation-for="Telefone1" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Ddd2" class="form-label">DDD 2</label>
            <input asp-for="Ddd2" class="form-control" /><span asp-validation-for="Ddd2" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Telefone2" class="form-label">Telefone 2</label>
            <input asp-for="Telefone2" class="form-control" /><span asp-validation-for="Telefone2" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Salario" class="form-label">Salário</label>
            <input asp-for="Salario" class="form-control" /><span asp-validation-for="Salario" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

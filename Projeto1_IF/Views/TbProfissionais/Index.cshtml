@model IEnumerable<Projeto1_IF.Models.TbProfissional>
@using Projeto1_IF.Security
@{
    ViewData["Title"] = "Profissionais";
    var gerente = User.IsInRole(AppRoles.GerenteGeral) || User.IsInRole(AppRoles.GerenteMedico)
        || User.IsInRole(AppRoles.GerenteNutricionista);
}

<h1>@(gerente ? "Profissionais" : "Meu cadastro profissional")</h1>
@if (!gerente && !Model.Any())
{
    <p>Não há um cadastro profissional associado à sua conta.</p>
}
<table class="table table-striped">
    <thead><tr><th>Nome</th><th>CPF</th><th>CRM/CRN</th><th>Ações</th></tr></thead>
    <tbody>
    @foreach (var profissional in Model)
    {
        <tr>
            <td>@profissional.Nome</td>
            <td>@profissional.Cpf</td>
            <td>@profissional.CrmCrn</td>
            <td>
                <a asp-action="Details" asp-route-id="@profissional.IdProfissional">Detalhes</a> |
                <a asp-action="Edit" asp-route-id="@profissional.IdProfissional">Editar</a>
                @if (gerente)
                {
                    <span> | <a asp-action="Delete" asp-route-id="@profissional.IdProfissional">Excluir</a></span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

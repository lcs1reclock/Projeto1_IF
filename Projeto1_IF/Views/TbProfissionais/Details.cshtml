@model Projeto1_IF.Models.TbProfissional
@{
    ViewData["Title"] = "Dados profissionais";
}

<h1>Dados profissionais</h1>
<dl class="row">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd>
    <dt class="col-sm-3">CPF</dt><dd class="col-sm-9">@Model.Cpf</dd>
    <dt class="col-sm-3">CRM/CRN</dt><dd class="col-sm-9">@Model.CrmCrn</dd>
    <dt class="col-sm-3">Especialidade</dt><dd class="col-sm-9">@Model.Especialidade</dd>
    <dt class="col-sm-3">Logradouro</dt><dd class="col-sm-9">@Model.Logradouro</dd>
    <dt class="col-sm-3">Número</dt><dd class="col-sm-9">@Model.Numero</dd>
    <dt class="col-sm-3">Bairro</dt><dd class="col-sm-9">@Model.Bairro</dd>
    <dt class="col-sm-3">CEP</dt><dd class="col-sm-9">@Model.Cep</dd>
    <dt class="col-sm-3">Cidade</dt><dd class="col-sm-9">@Model.Cidade</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Model.Estado</dd>
    <dt class="col-sm-3">Telefone 1</dt><dd class="col-sm-9">@Model.Ddd1 @Model.Telefone1</dd>
    <dt class="col-sm-3">Telefone 2</dt><dd class="col-sm-9">@Model.Ddd2 @Model.Telefone2</dd>
    <dt class="col-sm-3">Salário</dt><dd class="col-sm-9">@Model.Salario</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.IdProfissional" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>

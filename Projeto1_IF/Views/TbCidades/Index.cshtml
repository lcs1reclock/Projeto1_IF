@model IEnumerable<Projeto1_IF.Models.TbCidade>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdEstado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdEstadoNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TbPaciente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TbProfissional)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdEstado)
            </td>
            <td>
                @Html.DisplayFor(model => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdEstadoNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.TbPaciente)
            </td>
            <td>
                @Html.DisplayFor(model => item.TbProfissional)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdCidade">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdCidade">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdCidade">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

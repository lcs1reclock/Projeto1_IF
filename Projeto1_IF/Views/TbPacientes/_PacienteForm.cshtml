@* Lucas Pedroso do Bomdespacho *@
@model Projeto1_IF.Models.TbPaciente

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Rg" class="form-label"></label>
        <input asp-for="Rg" class="form-control" />
        <span asp-validation-for="Rg" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Cpf" class="form-label"></label>
        <input asp-for="Cpf" class="form-control" />
        <span asp-validation-for="Cpf" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DataNascimento" class="form-label">Data de nascimento</label>
        <input asp-for="DataNascimento" type="date" class="form-control" />
        <span asp-validation-for="DataNascimento" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="NomeResponsavel" class="form-label">Nome do responsável</label>
        <input asp-for="NomeResponsavel" class="form-control" />
        <span asp-validation-for="NomeResponsavel" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="Sexo" class="form-label"></label>
        <input asp-for="Sexo" class="form-control" maxlength="1" />
        <span asp-validation-for="Sexo" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="Etnia" class="form-label"></label>
        <input asp-for="Etnia" class="form-control" />
        <span asp-validation-for="Etnia" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Endereco" class="form-label">Endereço</label>
        <input asp-for="Endereco" class="form-control" />
        <span asp-validation-for="Endereco" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Bairro" class="form-label"></label>
        <input asp-for="Bairro" class="form-control" />
        <span asp-validation-for="Bairro" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="IdCidade" class="form-label">Cidade</label>
        <select asp-for="IdCidade" asp-items="@(ViewData["IdCidade"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select">
            <option value="">Selecione uma cidade</option>
        </select>
        <span asp-validation-for="IdCidade" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TelResidencial" class="form-label">Telefone residencial</label>
        <input asp-for="TelResidencial" class="form-control" />
        <span asp-validation-for="TelResidencial" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TelComercial" class="form-label">Telefone comercial</label>
        <input asp-for="TelComercial" class="form-control" />
        <span asp-validation-for="TelComercial" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TelCelular" class="form-label">Celular</label>
        <input asp-for="TelCelular" class="form-control" />
        <span asp-validation-for="TelCelular" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Profissao" class="form-label">Profissão</label>
        <input asp-for="Profissao" class="form-control" />
        <span asp-validation-for="Profissao" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FlgAtleta" class="form-label">Atleta</label>
        <select asp-for="FlgAtleta" class="form-select">
            <option value="">Não informado</option>
            <option value="true">Sim</option>
            <option value="false">Não</option>
        </select>
        <span asp-validation-for="FlgAtleta" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FlgGestante" class="form-label">Gestante</label>
        <select asp-for="FlgGestante" class="form-select">
            <option value="">Não informado</option>
            <option value="true">Sim</option>
            <option value="false">Não</option>
        </select>
        <span asp-validation-for="FlgGestante" class="text-danger"></span>
    </div>
</div>

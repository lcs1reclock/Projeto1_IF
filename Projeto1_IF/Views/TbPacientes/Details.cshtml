@* Lucas Pedroso do Bomdespacho *@
@model Projeto1_IF.Models.TbPaciente
@{
    ViewData["Title"] = "Detalhes do paciente";
}

<h1>Detalhes do paciente</h1>
<dl class="row">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd>
    <dt class="col-sm-3">RG</dt><dd class="col-sm-9">@Model.Rg</dd>
    <dt class="col-sm-3">CPF</dt><dd class="col-sm-9">@Model.Cpf</dd>
    <dt class="col-sm-3">Data de nascimento</dt><dd class="col-sm-9">@Model.DataNascimento.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Responsável</dt><dd class="col-sm-9">@Model.NomeResponsavel</dd>
    <dt class="col-sm-3">Sexo</dt><dd class="col-sm-9">@Model.Sexo</dd>
    <dt class="col-sm-3">Etnia</dt><dd class="col-sm-9">@Model.Etnia</dd>
    <dt class="col-sm-3">Endereço</dt><dd class="col-sm-9">@Model.Endereco</dd>
    <dt class="col-sm-3">Bairro</dt><dd class="col-sm-9">@Model.Bairro</dd>
    <dt class="col-sm-3">Cidade</dt><dd class="col-sm-9">@Model.IdCidadeNavigation?.Nome</dd>
    <dt class="col-sm-3">Telefone residencial</dt><dd class="col-sm-9">@Model.TelResidencial</dd>
    <dt class="col-sm-3">Telefone comercial</dt><dd class="col-sm-9">@Model.TelComercial</dd>
    <dt class="col-sm-3">Celular</dt><dd class="col-sm-9">@Model.TelCelular</dd>
    <dt class="col-sm-3">Profissão</dt><dd class="col-sm-9">@Model.Profissao</dd>
    <dt class="col-sm-3">Atleta</dt><dd class="col-sm-9">@(Model.FlgAtleta == null ? "Não informado" : Model.FlgAtleta.Value ? "Sim" : "Não")</dd>
    <dt class="col-sm-3">Gestante</dt><dd class="col-sm-9">@(Model.FlgGestante == null ? "Não informado" : Model.FlgGestante.Value ? "Sim" : "Não")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.IdPaciente" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
